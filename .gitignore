# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing and local reports
/coverage
/.nyc_output
/test-results
/playwright-report

# local development logs
*.log
*.log.*
# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem
*.local

# editors
.idea/
.vscode/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
/.vercel/

# local agent instructions and workspace metadata
/AGENTS.md
/CLAUDE.md
/.agents/
/.codex/

# typescript
*.tsbuildinfo
next-env.d.ts
